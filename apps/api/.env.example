# Neon Postgres (EU eu-central-1) — accounts, website families, consents, file metadata
DATABASE_URL=
# HS256 secret for session JWTs (long random string)
AUTH_JWT_SECRET=
DATA_REGION=eu-central-1

# The model provider behind apps/api/src/app/model/model.ts: openai (the default) or gemini
ANCHOR_MODEL_PROVIDER=openai
# OpenAI API (prompts may leave the EU — see Privacy)
OPENAI_API_KEY=
OPENAI_DATA_REGION_NOTE=openai-api-global
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
# Gemini Developer API, only when ANCHOR_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Sulafat
# BotFather token. Unset on Vercel: the bot long-polls from Cloud Run, not from a serverless function.
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
PUBLIC_URL=
CORS_ORIGINS=http://localhost:4321,https://anchor-open26.vercel.app,https://anchor-openhackathon2026.vercel.app,https://anchor-api-teal.vercel.app
# When true, POST /api/* requires a valid Bearer JWT
REQUIRE_AUTH=false
# Vercel Blob (auto-injected on Vercel when store is linked; copy token for local)
BLOB_READ_WRITE_TOKEN=

# Telegram family bot. Unset: the host starts no store, no tick, and no poll (the Vercel deploy leaves it unset)
TELEGRAM_BOT_TOKEN=
# Real seconds in one demo-clock day; the team test uses 120 or 600. Keep one value per state file, because a change moves the saved timeline
ANCHOR_DAY_SECONDS=86400
ANCHOR_STATE_FILE=tmp/anchor-state.json
# Zone of the 11:00 and 18:00 slots; set it when the host runs in UTC
# TZ=Europe/Athens
# v2: the Twilio number Anchor calls from, in E.164. Unset hides "Call me" in the choices screen
TWILIO_FROM=
# v2: the https:// base URL of anchor-bot; the call stream connects to wss:// on the same host
ANCHOR_PUBLIC_URL=
# v2: the OpenAI Realtime model of the call; the mini model paraphrased the fixed lines on a test call
ANCHOR_REALTIME_MODEL=gpt-realtime-2.1
# v2: true on anchor-bot, so the public service answers only GET / and the /call/stream upgrade, never /whatsapp or /api/*
ANCHOR_BOT_ONLY=
