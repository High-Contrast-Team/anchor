---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'Transform your family chat into a personalized, living memory assistant, no new apps needed. Keeping memories alive for the whole family.';
---

<BaseLayout title="Anchor" description={description} currentPath="/">
  <section class="slate-hero" aria-labelledby="slate-title">
    <div class="slate-hero-plane" aria-hidden="true"></div>
    <div class="slate-hero-inner">
      <h1 id="slate-title" class="slate-line">Memories That Live On</h1>
      <p class="slate-support">
        Transform your family chat into a living memory assistant. No new apps.
      </p>
      <div class="slate-actions">
        <a class="slate-btn slate-btn-primary" href="/family">Start Remembering Together</a>
        <a class="slate-text-link" href="/app">Try the demo</a>
        <a class="slate-text-link" href="/how-it-works">How it works</a>
      </div>
    </div>
  </section>

  <section class="slate-section" aria-labelledby="how-it-works">
    <h2 id="how-it-works" class="slate-heading">How it works</h2>
    <ul class="slate-steps">
      <li>
        <span class="slate-step-num" aria-hidden="true">1</span>
        <p>
          Share as you already do. Photos, voice notes, the silly Tuesday lunch. Anchor keeps them in the chat you
          already live in.
        </p>
      </li>
      <li>
        <span class="slate-step-num" aria-hidden="true">2</span>
        <p>
          Ask later. "Remind me what Maria did yesterday." Photos, video, and a spoken narration come back when it
          matters.
        </p>
      </li>
      <li>
        <span class="slate-step-num" aria-hidden="true">3</span>
        <p>
          Exercise gently. A photo, a soft prompt, then the story. Memory practice that feels like family, not a quiz.
        </p>
      </li>
    </ul>
  </section>

  <section class="slate-section" aria-labelledby="what-comes-back">
    <h2 id="what-comes-back" class="slate-heading">What comes back</h2>
    <p class="slate-section-lead">
      The same moments you already share, resurfaced so everyone can take part again.
    </p>
    <ul class="slate-list">
      <li>Stories in the words of the person who shared them</li>
      <li>Photos from ordinary days and the big ones</li>
      <li>Voice notes in familiar voices</li>
      <li>Pressure-free recall that invites a reply, a call, another round of laughing</li>
    </ul>
  </section>

  <section class="slate-section" aria-labelledby="choices">
    <h2 id="choices" class="slate-heading">Choices stay with the family</h2>
    <p class="slate-prose">
      Some memories are tender. Your loved one chooses, with family support, which ones may come back, and that choice can
      change. Stop and preferences live in the chat with Anchor. On this website you register with email, connect a group,
      and read the family record. Sensitive moments stay out of the shared list; export on{' '}
      <a class="slate-link" href="/my-data">My data</a> includes them for the person who shared them.
    </p>
  </section>

  <section class="slate-section" aria-labelledby="where-data-lives">
    <h2 id="where-data-lives" class="slate-heading">Where data lives</h2>
    <p class="slate-prose">
      You register with email first. Account data sits in Neon Postgres in the EU (<code>eu-central-1</code>). The family
      record from connected chats sits with the bot on Cloud Run in the EU (<code>europe-west1</code>), in Cloud Storage.
      The website and API run on Vercel. Prompts sent to OpenAI may leave the EU when the model runs. More detail is on
      the <a class="slate-link" href="/privacy">privacy page</a>.
    </p>
  </section>

  <section class="slate-section slate-close" aria-labelledby="slate-close">
    <h2 id="slate-close" class="slate-heading slate-heading-soft">Ready to keep those moments sparkling?</h2>
    <p class="slate-section-lead">
      Create an account, add Anchor to the group chat you already use, then share a moment.
    </p>
    <div class="slate-actions">
      <a class="slate-btn slate-btn-primary" href="/family">Start Remembering Together</a>
      <a class="slate-text-link" href="/app">Try the demo</a>
      <a class="slate-text-link" href="/how-it-works">How it works</a>
    </div>
  </section>
</BaseLayout>
